---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photoDetails } from '../data/photos';
import { site } from '../data/site';

// Every image in src/photos/ shows up here, in file-name order.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const src = mod.default;
      const name = path.split('/').pop()!;
      const thumb = await getImage({ src, width: Math.min(800, src.width), format: 'webp' });
      const full = await getImage({ src, width: Math.min(2000, src.width), format: 'webp' });
      const { description = '', location = '', camera = '' } = photoDetails[name] ?? {};
      return { name, description, location, camera, thumb, full, width: src.width, height: src.height };
    }),
);
---

<Base title={`Photos · ${site.name}`}>
  <main class="container">
    <h1>Photos</h1>

    {photos.length === 0 && <p class="empty">No photos yet.</p>}

    <div class="grid">
      {
        photos.map((p, i) => (
          <button class="item" type="button" data-index={i} aria-label={`Open photo ${i + 1}`}>
            <img src={p.thumb.src} width={p.width} height={p.height} alt={p.description || p.location} loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
  </main>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="close" type="button" aria-label="Close">×</button>
    <button class="nav prev" type="button" aria-label="Previous photo">‹</button>
    <figure>
      <img alt="" />
      <span class="info" aria-hidden="true">i</span>
      <figcaption></figcaption>
    </figure>
    <button class="nav next" type="button" aria-label="Next photo">›</button>
  </dialog>

  <script
    is:inline
    type="application/json"
    id="photo-data"
    set:html={JSON.stringify(photos.map(({ full, description, location, camera }) => ({ src: full.src, description, location, camera })))}
  />
</Base>

<style>
  h1 {
    font-size: 2.2rem;
    margin: 2rem 0 1.5rem;
  }

  .empty {
    color: var(--muted);
  }

  /* Masonry-style columns that keep each photo's aspect ratio. */
  .grid {
    columns: 3 220px;
    column-gap: 12px;
    padding-bottom: 4rem;
  }

  .item {
    display: block;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--faint);
    cursor: zoom-in;
    break-inside: avoid;
  }

  .item img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.15s;
  }

  .item:hover img {
    opacity: 0.88;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0a0c0e;
    color: #f1f2f3;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  /* The figure shrink-wraps the photo so the description overlays it exactly. */
  figure {
    position: relative;
    margin: 0;
    border-radius: 4px;
    overflow: hidden;
  }

  figure img {
    display: block;
    max-width: calc(100vw - 140px);
    max-height: calc(100vh - 80px);
    object-fit: contain;
  }

  /* Description: hidden until the photo is hovered (or tapped on touch screens). */
  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3rem 1.25rem 1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
    color: #f1f2f3;
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  /* Caption contents are created by the script below, hence :global. */
  figcaption :global(.description) {
    margin: 0 0 0.4rem;
  }

  figcaption :global(.meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font-size: 0.8rem;
    color: #c3cad0;
  }

  figcaption :global(.meta span) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  figcaption :global(svg) {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Small hint in the corner that a description exists. */
  .info {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #f1f2f3;
    font: italic 600 0.8rem Georgia, serif;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  figure:not(.has-description) figcaption,
  figure:not(.has-description) .info {
    display: none;
  }

  @media (hover: hover) {
    figure:hover figcaption {
      opacity: 1;
    }
    figure:hover .info {
      opacity: 0;
    }
  }

  figure.show figcaption {
    opacity: 1;
  }

  figure.show .info {
    opacity: 0;
  }

  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-size: 2.4rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    opacity: 0.7;
  }

  .lightbox button:hover {
    opacity: 1;
  }

  .close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .prev {
    left: 0.5rem;
  }

  .next {
    right: 0.5rem;
  }

  @media (max-width: 600px) {
    figure {
      border-radius: 0;
    }

    figure img {
      max-width: 100vw;
    }

    .nav {
      top: auto;
      bottom: 1rem;
    }
  }
</style>

<script>
  type Photo = { src: string; description: string; location: string; camera: string };
  const photos: Photo[] = JSON.parse(document.getElementById('photo-data')!.textContent!);

  const icons = {
    location: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>',
    camera: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 6.5 10 4h4l1.5 2.5H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8.5a2 2 0 0 1 2-2z"/><circle cx="12" cy="13" r="3.5"/></svg>',
  };

  // Description on top, then a smaller line with location and camera.
  function fillCaption(p: Photo) {
    caption.replaceChildren();
    if (p.description) {
      const d = document.createElement('p');
      d.className = 'description';
      d.textContent = p.description;
      caption.append(d);
    }
    const meta = document.createElement('div');
    meta.className = 'meta';
    for (const key of ['location', 'camera'] as const) {
      if (!p[key]) continue;
      const item = document.createElement('span');
      item.innerHTML = icons[key];
      item.append(p[key]);
      meta.append(item);
    }
    if (meta.childElementCount) caption.append(meta);
  }
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const figure = dialog.querySelector('figure')!;
  const img = figure.querySelector('img')!;
  const caption = figure.querySelector('figcaption')!;
  let index = 0;

  function show(i: number) {
    index = (i + photos.length) % photos.length;
    const p = photos[index];
    img.src = p.src;
    img.alt = p.description || p.location;
    fillCaption(p);
    figure.classList.toggle('has-description', caption.childElementCount > 0);
    figure.classList.remove('show');
  }

  // Touch screens can't hover, so tapping the photo toggles its description.
  img.addEventListener('click', () => {
    if (window.matchMedia('(hover: none)').matches) figure.classList.toggle('show');
  });

  document.querySelectorAll<HTMLButtonElement>('.item').forEach((btn) =>
    btn.addEventListener('click', () => {
      show(Number(btn.dataset.index));
      dialog.showModal();
    }),
  );

  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));

  // Click outside the photo to close.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
