---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { captions } from '../data/photos';
import { site } from '../data/site';

// Every image in src/photos/ shows up here, in file-name order.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const src = mod.default;
      const name = path.split('/').pop()!;
      const thumb = await getImage({ src, width: Math.min(800, src.width), format: 'webp' });
      const full = await getImage({ src, width: Math.min(2000, src.width), format: 'webp' });
      return { name, caption: captions[name] ?? '', thumb, full, width: src.width, height: src.height };
    }),
);
---

<Base title={`Photos · ${site.name}`} backLink>
  <main class="container">
    <h1>Photos</h1>

    {photos.length === 0 && <p class="empty">No photos yet.</p>}

    <div class="grid">
      {
        photos.map((p, i) => (
          <button class="item" type="button" data-index={i} aria-label={p.caption || `Open photo ${i + 1}`}>
            <img src={p.thumb.src} width={p.width} height={p.height} alt={p.caption} loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
  </main>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="close" type="button" aria-label="Close">×</button>
    <button class="nav prev" type="button" aria-label="Previous photo">‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="nav next" type="button" aria-label="Next photo">›</button>
  </dialog>

  <script
    is:inline
    type="application/json"
    id="photo-data"
    set:html={JSON.stringify(photos.map((p) => ({ src: p.full.src, caption: p.caption })))}
  />
</Base>

<style>
  h1 {
    font-size: 2.2rem;
    margin: 2rem 0 1.5rem;
  }

  .empty {
    color: var(--muted);
  }

  /* Masonry-style columns that keep each photo's aspect ratio. */
  .grid {
    columns: 3 220px;
    column-gap: 12px;
    padding-bottom: 4rem;
  }

  .item {
    display: block;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--faint);
    cursor: zoom-in;
    break-inside: avoid;
  }

  .item img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.15s;
  }

  .item:hover img {
    opacity: 0.88;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 12, 14, 0.94);
    color: #f1f2f3;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  figure img {
    max-width: calc(100vw - 140px);
    max-height: calc(100vh - 110px);
    object-fit: contain;
    border-radius: 4px;
  }

  figcaption {
    font-size: 0.9rem;
    color: #b9c0c6;
    min-height: 1.4em;
  }

  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-size: 2.4rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    opacity: 0.7;
  }

  .lightbox button:hover {
    opacity: 1;
  }

  .close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .prev {
    left: 0.5rem;
  }

  .next {
    right: 0.5rem;
  }

  @media (max-width: 600px) {
    figure img {
      max-width: 100vw;
      border-radius: 0;
    }

    .nav {
      top: auto;
      bottom: 1rem;
    }
  }
</style>

<script>
  const photos: { src: string; caption: string }[] = JSON.parse(
    document.getElementById('photo-data')!.textContent!,
  );
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  let index = 0;

  function show(i: number) {
    index = (i + photos.length) % photos.length;
    img.src = photos[index].src;
    img.alt = photos[index].caption;
    caption.textContent = photos[index].caption;
  }

  document.querySelectorAll<HTMLButtonElement>('.item').forEach((btn) =>
    btn.addEventListener('click', () => {
      show(Number(btn.dataset.index));
      dialog.showModal();
    }),
  );

  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));

  // Click outside the photo to close.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
