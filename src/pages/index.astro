---
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import { Content as Bio } from '../data/bio.md';
import bib from '../data/publications.bib?raw';
import { parseBibtex } from '../lib/bibtex';
import { site } from '../data/site';

const publications = parseBibtex(bib);
---

<Base>
  <header class="hero">
    <div class="container hero-inner">
      <img class="photo" src={site.photo} alt={`Photo of ${site.name}`} width="180" height="212" />
      <div>
        <h1>{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <nav class="links">
          {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>
  </header>

  <main class="container">
    <section id="about" class="bio">
      <Bio />
    </section>

    <section id="publications">
      <h2>Publications</h2>
      {publications.map((pub) => <Publication pub={pub} />)}
    </section>
  </main>

  <footer class="container">
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>
</Base>

<style>
  .hero {
    padding: 2.5rem 0 3.5rem;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .photo {
    flex-shrink: 0;
    width: 180px;
    height: 212px;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 12px 32px -12px rgba(0, 0, 0, 0.25);
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    margin: 0;
  }

  .tagline {
    margin: 0.4rem 0 1.1rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .links a {
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--faint);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
  }

  .links a:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .bio :global(p) {
    margin: 0 0 1rem;
  }

  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  footer p {
    margin: 0;
    padding: 2rem 0 3rem;
    color: var(--muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--faint);
  }

  @media (max-width: 600px) {
    .hero {
      padding: 1.5rem 0 2.5rem;
    }

    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .photo {
      width: 140px;
      height: 165px;
    }
  }
</style>
